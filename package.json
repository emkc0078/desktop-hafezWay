{
  "name": "desktop-hafezway-admin",
  "private": true,
  "version": "0.1.13",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "bump": "node scripts/bump-version.cjs",
    "icons": "node scripts/prepare-icons.cjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "cross-env NODE_ENV=production electron .",
    "dist": "npm run bump && npm run icons && npm run build && electron-builder --publish never",
    "dist:win": "npm run bump && npm run icons && npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run bump && npm run icons && npm run build && electron-builder --mac --publish never",
    "dist:ci": "npm run icons && npm run build && electron-builder --publish never",
    "release": "npm run bump && npm run icons && npm run build && electron-builder --win --mac --x64 --publish always && node scripts/print-release-link.cjs",
    "release:win": "npm run bump && npm run icons && npm run build && electron-builder --win --x64 --publish always && node scripts/print-release-link.cjs",
    "release:mac": "npm run bump && npm run icons && npm run build && electron-builder --mac --publish always && node scripts/print-release-link.cjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "precommit": "npm run typecheck && npm run lint",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.hafezway.admin",
    "productName": "Hafez Way Admin",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/hafezway-backup",
        "to": "scripts/hafezway-backup"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hafez Way Admin",
      "include": "build/installer.nsh"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "emkc0078",
        "repo": "desktop-hafezWay"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.11.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "wait-on": "^9.0.3"
  }
}
